# Firebase Admin SDK — gere em: Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=seu-projeto-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Caminho para salvar a sessão do WhatsApp
# No Railway: configure um Volume montado em /data e use /data/session
WHATSAPP_SESSION_PATH=/data/session

# Timezone offset em horas (BRT = -3)
TZ_OFFSET=-3

# Porta HTTP (Railway define automaticamente via PORT)
# PORT=3000
